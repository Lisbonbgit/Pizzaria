# ==========================================================
# Pizzaria frontend — exemplo de variáveis de ambiente
# Copie para "frontend/.env" se quiser correr localmente (yarn start).
# ==========================================================

# URL base do backend.
#
# - Em PRODUÇÃO com Docker Compose + Caddy (mesmo domínio para frontend e /api),
#   DEIXE VAZIO. O frontend chama "/api" na própria origem (sem CORS).
#       REACT_APP_BACKEND_URL=
#
# - Em desenvolvimento local, aponte para o backend local:
#       REACT_APP_BACKEND_URL=http://localhost:8001
REACT_APP_BACKEND_URL=
