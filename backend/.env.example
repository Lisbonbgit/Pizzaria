# ==========================================================
# Pizzaria backend — exemplo de variáveis de ambiente
# Copie para "backend/.env" e preencha com os valores reais.
# NUNCA faça commit do .env com segredos.
# ==========================================================

# --- Base de dados (MongoDB Atlas) ---
# Connection string do cluster Atlas. Ex.:
# mongodb+srv://utilizador:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URL="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="pizzaria"

# --- Segurança ---
# Gere um segredo forte com:  openssl rand -hex 32
JWT_SECRET="MUDE_ISTO_para_um_segredo_aleatorio_forte"

# Origens permitidas para CORS (separadas por vírgula).
# Em produção, use o seu domínio real em vez de "*".
CORS_ORIGINS="https://app.lenhaebrasa.com"

# --- Login do administrador ---
ADMIN_EMAIL="admin@lenhaebrasa.com"
# Gere o hash com:  python scripts/generate_password_hash.py
ADMIN_PASSWORD_HASH=""

# --- Print Agent (impressoras locais) ---
# Gere uma chave forte com:  openssl rand -hex 24
PRINT_AGENT_API_KEY=""

# --- Relatório diário por email (Resend) ---
# Chave da API em https://resend.com (Settings > API Keys)
RESEND_API_KEY=""
# Email que recebe o relatório diário (23:59 Europe/Lisbon)
REPORT_EMAIL="dono@lenhaebrasa.com"
# Remetente. Use onboarding@resend.dev para testar, ou um domínio verificado no Resend.
REPORT_SENDER_EMAIL="onboarding@resend.dev"
