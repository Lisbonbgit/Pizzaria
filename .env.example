# ==========================================================
# Variáveis do Docker Compose (raiz do projeto)
# Copie para ".env" na raiz e preencha.
# (O backend tem o SEU próprio .env em backend/.env)
# ==========================================================

# Domínio público que aponta (DNS tipo A) para o IP do Hostinger VPS.
# O Caddy emite o certificado HTTPS automaticamente para este domínio.
DOMAIN=app.lenhaebrasa.com

# Email para os avisos do Let's Encrypt.
ACME_EMAIL=admin@lenhaebrasa.com
