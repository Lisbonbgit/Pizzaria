# Caddy edge — HTTPS automático (Let's Encrypt) + reverse proxy.
# O domínio e o email vêm do .env (variáveis DOMAIN e ACME_EMAIL).

{
	# Email para o Let's Encrypt (avisos de expiração). Default se não definido.
	email {$ACME_EMAIL:admin@lenhaebrasa.com}
}

{$DOMAIN} {
	encode gzip

	# Pedidos /api/* → backend FastAPI (mantém o prefixo /api).
	handle /api/* {
		reverse_proxy backend:8001
	}

	# Tudo o resto → SPA React servido pelo nginx do container "frontend".
	handle {
		reverse_proxy frontend:80
	}
}

# Domínio antigo dos QR já impressos (pedir.lenhaebrasa.com) → redireciona para o
# domínio correto (pedido), mantendo o caminho e o ?mesa=N. Assim os QR que já
# estão colados nas mesas passam a funcionar sem reimprimir.
# Requer DNS: pedir.lenhaebrasa.com a apontar para o VPS (CNAME p/ pedido ou A record).
pedir.lenhaebrasa.com {
	redir https://{$DOMAIN}{uri} permanent
}
