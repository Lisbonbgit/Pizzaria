# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing / coverage
/coverage

# Production builds
build/
dist/

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
print_agent/logs/
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*.pyc
venv/
.venv/

# Environment files — NUNCA versionar segredos reais...
.env
.env.*
*.env
# ...mas manter os templates de exemplo versionados:
!.env.example
!*.env.example
!print_agent/config.env

# Artefactos do Emergent (ignorados; o OneDrive pode recriá-los no disco)
.emergent/

# Credentials
*token.json*
*credentials.json*
credentials.json
*.key
.credentials

# Pytest
.pytest_cache/

# APK da ponte de impressão (servido por volume, não versionado)
backend/appfiles/
